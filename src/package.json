{
  "name": "project-forecast-analysis-tool",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "scripts": {
    "dev": "pnpm start:local",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:legacy-singlefile": "tsc -b && vite build --config vite.singlefile.config.ts",
    "serve:local": "tsx server/index.ts",
    "start:local": "pnpm build && pnpm serve:local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
